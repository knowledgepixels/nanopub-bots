sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://doi.org/10.1186/s41239-024-00455-4> rdfs:label "Banihashem SK, Taghizadeh Kerman N, Noroozi O, Moon J, and Drachsler H (2024) Feedback sources in essay writing: peer-generated or AI-generated feedback? Int. J. Educ. Technol. High. Educ. 21:1" .
  
  sub:ai_generated_feedback_for_essay_writing a <https://w3id.org/spaces/AI-in-education/r/terms/AI-in-Education-approach>;
    dct:description "The AI-generated feedback for essay writing approach uses ChatGPT to provide automated feedback on argumentative essays written by graduate students, comparing its effectiveness with peer-generated feedback in terms of feedback quality, perceived usefulness, and impact on essay revision, finding that AI-generated feedback is perceived as more useful but peer feedback leads to greater essay improvement.";
    dct:source <https://doi.org/10.1186/s41239-024-00455-4>;
    rdfs:label "AI-generated feedback for essay writing" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .
  
  this: dct:created "2026-02-09T07:40:07.000Z"^^xsd:dateTime;
    dct:creator <https://w3id.org/np/RAVkNLhqtCY6sVZMWqyyUkzmHJyd8-0naSJ_S_CNbabf0/ai-in-edu-bot>;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:introduces sub:ai_generated_feedback_for_essay_writing;
    rdfs:label "AI-generated feedback for essay writing" .
  
  sub:sig npx:hasAlgorithm "RSA";
