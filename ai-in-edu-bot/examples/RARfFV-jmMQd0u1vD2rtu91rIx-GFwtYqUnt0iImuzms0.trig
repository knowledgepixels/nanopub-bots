sub:assertion {
  <https://doi.org/10.3389/feduc.2024.1288723> rdfs:label "Jauhiainen JS and Garagorry Guerra A (2024) Generative AI and education: dynamic personalization of pupils’ school learning material with ChatGPT. Front. Educ. 9:1288723" .
  
  sub:dynamic_learning_material_personalization a <https://w3id.org/spaces/AI-in-education/r/terms/AI-as-personalized-learning-tool>,
      <https://w3id.org/spaces/AI-in-education/r/terms/AI-in-Education-approach>;
    dct:description "The Dynamic personalization of learning material with ChatGPT approach uses ChatGPT to generate and continuously adapt instructional texts, questions, and illustrations in real time to match individual pupils’ knowledge levels during a lesson, thereby tailoring curriculum-aligned learning materials dynamically to each student’s understanding and performance.";
    dct:source <https://doi.org/10.3389/feduc.2024.1288723>;
    rdfs:label "Dynamic personalization of learning material with ChatGPT" .
}

