  ror:00x7ekv49 foaf:name "Centrum Wiskunde & Informatica, Amsterdam, Netherlands" .
  
  sub:author-list rdf:_1 orcid:0000-0002-7114-6459;
    rdf:_2 orcid:0000-0002-1267-0234;
    rdf:_3 orcid:0000-0002-3357-9130 .
}

